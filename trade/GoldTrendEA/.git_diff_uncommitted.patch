+//+------------------------------------------------------------------+
+void ReconcileOfflineDeals()
+  {
+   ENUM_EA_STATE savedState = g_posMgr.SavedState();
+   if(savedState != STATE_POSITION_OPEN && savedState != STATE_CLOSING)
