+     }
+
+   ulong  lastTicket = g_risk.LastDealTicket();
+   int    found      = 0;
+   double profitSum  = 0.0;
+   int    total      = HistoryDealsTotal();
+   for(int i = 0; i < total; i++)
+     {
+      ulong deal = HistoryDealGetTicket(i);
+      if(deal == 0 || deal <= lastTicket)
+         continue;                         // 已入账过的成交跳过（防重复）
